  meetingDepartureTarget: {fileID: 1774723628}
  requiredQuestId: QST-TUTO-007
  portalSignalTargetId: TUTORIAL-C02-TO-A03
  guideArrivalOffset: {x: -1.1, y: 1.1, z: 0}

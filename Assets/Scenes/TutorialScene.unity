  questSequence:
  - {fileID: 11400000, guid: d31dab047603147fe9ffcf057669514d, type: 2}
  - {fileID: 11400000, guid: 1de3bee7ec05f44859ace4fa5950b2c4, type: 2}
  - {fileID: 11400000, guid: b4472259cfd9d4c67ae6e35492185366, type: 2}
  - {fileID: 11400000, guid: 7a948ab8a878444b8af4b3529f81cbb8, type: 2}
  - {fileID: 11400000, guid: 52995dda3c0554fd19424243b4268845, type: 2}
  - {fileID: 11400000, guid: f66fdecbd28634437b20f03c6bd13d8e, type: 2}
  - {fileID: 11400000, guid: 407f0de82bb334d8cb731d75ddedb6d4, type: 2}
  - {fileID: 11400000, guid: 08e5362aec7944e049bd5ce0f2fdac6e, type: 2}
  - {fileID: 11400000, guid: 9b72d7891b43c464aa55aa0027fb6415, type: 2}
  - {fileID: 11400000, guid: 6bfb197efe8304a4c863834fb244d633, type: 2}
  objectiveTexts:
  - "\uBE44\uD589\uC120 \uD328\uC2A4\uD0A4\uB97C \uD655\uBCF4\uD558\uACE0 \uD6C8\uB828\uC7A5
    \uC785\uAD6C\uB85C \uC774\uB3D9"
  - "\uBB34\uC801 \uB300\uC2DC\uB85C \uBD88\uAE30\uB465 3\uAC1C\uB97C \uD1B5\uACFC\uD574
    \uB3C4\uCC29\uC810\uC5D0 \uB3C4\uB2EC"
  - "\uB354\uBE14 \uC810\uD504\uB85C \uAC00\uC7A5 \uB192\uC740 \uBC1C\uD310\uC758
    \uB3C4\uCC29 \uB9C8\uCEE4\uC5D0 \uB3C4\uB2EC"
  - "\uD6C8\uB828\uC7A5 \uC548\uC5D0\uC11C \uC804\uBC29 \uD22C\uC0AC\uCCB4 3\uD68C
    \uC810\uD504 \uD68C\uD53C"
  - "\uD6C8\uB828\uC6A9 \uC5D0\uB108\uBBF8\uC5D0\uAC8C \uAE30\uBCF8 \uACF5\uACA9
    3\uCF64\uBCF4 \uC801\uC911"
  - "\uC6D0\uAC70\uB9AC \uACF5\uACA9 \uD55C \uBC1C\uB85C \uD6C8\uB828\uC6A9 \uC5D0\uB108\uBBF8
    3\uAE30 \uB3D9\uC2DC \uD0C0\uACA9"
  - "\uC2B5\uACA9 \uACBD\uBCF4\uC5D0 \uB530\uB77C \uD68C\uC758\uC7A5\uACFC \uC678\uBD80
    \uCD9C\uAD6C\uB85C \uB300\uD53C"
  - "\uBCF8\uBD80 \uC678\uACFD \uD1B5\uB85C\uC758 \uD310\uB3C4\uB77C \uAC1C\uCCB4
    \uC804\uC6D0 \uCC98\uCE58"
  - "\uB098\uB514\uB974 \uC120\uCC29\uC7A5 \uC9C4\uC785\uB85C\uC758 \uD310\uB3C4\uB77C
    \uAC1C\uCCB4 \uC804\uC6D0 \uCC98\uCE58"
  - "\uD5EC\uD14C\uC640 \uC870\uC6B0\uD574 \uC804\uD22C\uB97C \uC644\uB8CC"

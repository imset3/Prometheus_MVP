    englishName: Theus
    description: "\uC544\uB2E4\uB9C8\uC2A4\uC758 \uBA64\uBC84\uC774\uC790 \uD504\uB85C\uBA54\uC758
      \uC5EC\uD589\uC744 \uB3D5\uB294 AI.\n\uC8FC\uBCC0 \uD658\uACBD\uACFC \uBB3C\uAC74\uC744
      \uBD84\uC11D\uD558\uACE0 \uBAA9\uC801\uC9C0\uAE4C\uC9C0 \uB3D9\uD589\uD55C\uB2E4."
    showAfterDialogue: 1
  - questId: QST-TUTO-007
    displayName: "\uD06C\uB9AC\uC628"
    englishName: Cryon
    description: "\uC544\uB2E4\uB9C8\uC2A4\uC758 \uC815\uCC30 \uB300\uC6D0.\n\uD0D0\uC0AC
      \uC7A5\uBE44\uB97C \uAD00\uB9AC\uD558\uBA70 \uD504\uB85C\uBA54\uC758 \uC774\uB3D9\uC744
      \uC9C0\uC6D0\uD55C\uB2E4."
    showAfterDialogue: 0
  - questId: QST-TUTO-005
    displayName: "\uC6D0\uAC70\uB9AC \uACF5\uACA9"
    englishName: Ranged Attack
    description: "\uD504\uB85C\uBA54\uC758 \uBB34\uAE30\uC5D0 \uB0B4\uC7A5\uB41C
      \uAE30\uBCF8 \uC6D0\uAC70\uB9AC \uACF5\uACA9.\n2\uBC88 \uD0A4\uB97C \uB204\uB974\uBA74
      \uD604\uC7AC \uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5\uC73C\uB85C \uAD00\uD1B5
      \uD22C\uC0AC\uCCB4\uB97C \uBC1C\uC0AC\uD55C\uB2E4."
    showAfterDialogue: 0
  - questId: QST-TUTO-008-HELTE
    displayName: "\uD5EC\uD14C"
    englishName: Helte
    description: "\uC120\uCC29\uC7A5\uC5D0\uC11C \uD504\uB85C\uBA54\uB97C \uB9C9\uC544\uC120
      \uB370\uBBF8\uC6B0\uB974\uACE0\uC2A4.\n\uC774\uB3C4\uB958\xB7\uBE14\uB9C1\uD06C\xB7\uACE0\uC18D
      \uB300\uC2DC\uB97C \uC77D\uACE0 \uADFC\uC811\uACFC \uC6D0\uAC70\uB9AC \uACF5\uACA9\uC73C\uB85C
      \uB300\uC751\uD55C\uB2E4."
    showAfterDialogue: 1
